#!/bin/sh
set -eu

pidfile=/run/zxs-https/stunnel.pid

start() {
    if [ ! -s /etc/zxs/https/server.pem ]; then
        echo 'HTTPS: no certificate; use zxs-https generate or install to enable.'
        return 0
    fi
    mkdir -p /run/zxs-https
    chown nobody:nobody /run/zxs-https
    chmod 0750 /run/zxs-https
    if [ -s "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        return 0
    fi
    rm -f "$pidfile"
    /usr/bin/stunnel /etc/stunnel/stunnel.conf
}

stop() {
    if [ -s "$pidfile" ]; then
        if ! kill -0 "$(cat "$pidfile")" 2>/dev/null; then
            rm -f "$pidfile"
            return 0
        fi
        start-stop-daemon -K -q -p "$pidfile" --exec /usr/bin/stunnel || return 1
        attempt=0
        while [ "$attempt" -lt 10 ]; do
            if [ ! -s "$pidfile" ] || ! kill -0 "$(cat "$pidfile")" 2>/dev/null; then
                rm -f "$pidfile"
                return 0
            fi
            sleep 1
            attempt=$((attempt + 1))
        done
        echo 'HTTPS: stunnel did not stop.' >&2
        return 1
    fi
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart|reload) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 2 ;;
esac
